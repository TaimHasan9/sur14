# Database (used by Drizzle ORM & drizzle.config.ts)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Initial Super Admin Credentials (never use weak passwords like admin123)
ADMIN_INITIAL_EMAIL=admin@mrtomgadgets.com
ADMIN_INITIAL_PASSWORD=MrTom#Admin2026!Secure9

# Protected Seed Secret (required for manual /api/seed calls by non-session CLI)
SEED_SECRET=mrtom-seed-secret-key-2026

# Payment Gateway (Stripe / SSLCommerz / Webhook Verification)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=whsec_mrtom_gateway_secret_2026
PAYMENT_WEBHOOK_SECRET=whsec_mrtom_gateway_secret_2026

# Cloud Image Storage (Cloudinary / S3 / R2)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# Transactional Email (Resend / SMTP)
RESEND_API_KEY=
EMAIL_FROM=no-reply@mrtomgadgets.com

# Courier Integration (Steadfast / Pathao / RedX)
